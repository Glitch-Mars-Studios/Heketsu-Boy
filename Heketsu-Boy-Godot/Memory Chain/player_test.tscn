[sub_resource type="GDScript" id="GDScript_yf5fn"]
script/source = "extends CharacterBody2D




#region Movement Var
const SPEED = 300.0
const JUMP_VELOCITY = -400.0
var max_speed = 52.0
var accel = 24.5
var friction = 22.5

#endregion

# Party Members
const FOLLOWER = preload(\"uid://ekwn2sbeo2dh\")

var followers : Array[Node2D] = []
var party_offset : float = 12.0
var trail : Array[Vector2] = []

func _ready() -> void:
	spawn_follower()

func _physics_process(_delta: float) -> void:
	# Handle jump.
	if Input.is_action_just_pressed(\"ui_accept\"):
		velocity.y = JUMP_VELOCITY
	# Get the input direction and handle the movement/deceleration.
	# As good practice, you should replace UI actions with custom gameplay actions.
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
	move_and_slide()

## This Script (and Node) is only used to display the Memory Chain Effect


func follower_logic() -> void:
	if trail.is_empty() || trail[0].distance_to(global_position) >= 1.0:
		trail.push_front(global_position)
	
	var max_trail_length : float = followers.size() * party_offset
	while trail.size() > max_trail_length:
		trail.pop_back()
	
	for i in followers.size():
		var path_pos : Vector2 = get_point_along_trail(party_offset * (i + 1))
		followers[i].player_moving = true if round(velocity) else false
		followers[i].target_pos = path_pos

func get_point_along_trail(distance : float) -> Vector2:
	var total : float = 0.0
	for i in range(trail.size() - 1):
		var point_a : Vector2 = trail[i]
		var point_b : Vector2 = trail[i + 1]
		var segment_length: float = point_a.distance_to(point_b)
		if total + segment_length >= distance:
			var t : float = (distance - total) / segment_length
			return point_a.lerp(point_b, t)
		total += segment_length
	return trail.back()

func spawn_follower() -> void:
	var new_follower : Node2D = FOLLOWER.instantiate()
	
	new_follower.acceleration = accel
	new_follower.friction = friction
	
	if trail.is_empty():
		trail.append(global_position)
	new_follower.global_position = get_point_along_trail(party_offset * (followers.size() + 1))
	
	get_parent().add_child.call_deferred(new_follower)
	
	followers.append(new_follower)
"

